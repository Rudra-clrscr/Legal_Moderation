# All settings use the LEGAL_ prefix. See app/config.py for the full list.
LEGAL_DATA_DIR=data
LEGAL_MAX_UPLOAD_MB=50

# Qwen2.5-7B-Instruct (ChatML) ...
LEGAL_LLM_MODEL_PATH=models/qwen2.5-7b-instruct-awq-onnx-int4
LEGAL_LLM_PROMPT_TEMPLATE=chatml
# ... or SaulLM-7B-Instruct (Mistral format)
# LEGAL_LLM_MODEL_PATH=models/saullm-7b-instruct-onnx-int4
# LEGAL_LLM_PROMPT_TEMPLATE=mistral

# Optional: override the provider in genai_config.json (cuda, dml, cpu)
# LEGAL_LLM_EXECUTION_PROVIDER=dml
LEGAL_LLM_CONTEXT_WINDOW=8192
LEGAL_LLM_MAX_NEW_TOKENS=1024

# OCR chain, tried in order (JSON list)
LEGAL_PARSER_STRATEGIES=["marker", "marker_enhanced_ocr", "unstructured", "pypdf"]
